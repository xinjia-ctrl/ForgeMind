# ForgeMind Web reads credentials only on the backend. Copy this file to .env,
# then fill only the providers you use. Never commit the real .env file.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
BIGMODEL_API_KEY=
# ZHIPU_API_KEY= is also accepted as an alias for BIGMODEL_API_KEY.
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=

# Optional initial selection shown when the local Web workspace opens.
FORGEMIND_PROVIDER=deepseek
FORGEMIND_MODEL=deepseek-flash
FORGEMIND_STRUCTURED_OUTPUT=1
FORGEMIND_TEMPERATURE=0
FORGEMIND_MAX_REWORK=6

# Optional real-agent evaluation override. By default eval:real reuses
# FORGEMIND_PROVIDER/FORGEMIND_MODEL and that provider's credential above.
# FORGEMIND_EVAL_PROVIDER=deepseek
# FORGEMIND_EVAL_MODEL=deepseek-flash
# FORGEMIND_EVAL_BASE_URL=https://api.deepseek.com
# FORGEMIND_EVAL_TRIALS=3
# FORGEMIND_EVAL_SCENARIOS=single-file-defect-fix,input-validation-edge-cases
# FORGEMIND_EVAL_KEEP_REPOS=0
# FORGEMIND_EVAL_INPUT_USD_PER_MILLION=
# FORGEMIND_EVAL_OUTPUT_USD_PER_MILLION=
# FORGEMIND_EVAL_PRICE_LABEL=Provider price snapshot and estimation assumptions

# Only needed for the custom OpenAI-compatible option or legacy configuration.
# OPENAI_BASE_URL=https://api.example.com/v1
