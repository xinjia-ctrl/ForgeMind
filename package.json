{
  "name": "forgemind",
  "version": "0.1.0",
  "description": "Production-oriented multi-agent coding workflow orchestrator",
  "type": "module",
  "private": true,
  "bin": {
    "forge-mind": "./dist/src/runtime/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test dist/tests/*/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
