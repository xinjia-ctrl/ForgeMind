{
  "name": "forgemind",
  "version": "3.0.0",
  "description": "Evidence-gated coding agent for local Git repositories",
  "type": "module",
  "private": false,
  "files": [
    "dist/src",
    "README.md",
    "docs/README.md",
    "docs/PRD.md",
    "docs/ARCHITECTURE.md",
    "docs/PRODUCT_MANUAL.md",
    "docs/EVALUATION.md",
    "docs/LIMITATIONS.md",
    "docs/VISION.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "forge-mind": "./dist/src/runtime/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run build && node --test dist/tests/*/*.test.js",
    "test:smoke": "npm run build && node --test dist/tests/smoke/*.test.js",
    "test:smoke:release": "npm run build && node scripts/run-release-smoke.mjs",
    "web": "npm run build && node --env-file-if-exists=.env dist/src/runtime/cli.js web",
    "eval": "npm run prompt:contract && npm run eval:real",
    "prompt:contract": "npm run build && node dist/evals/prompt-eval.js",
    "eval:contract": "npm run prompt:contract",
    "eval:real": "npm run build && node --env-file-if-exists=.env dist/evals/agent-eval.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinjia-ctrl/ForgeMind.git"
  },
  "homepage": "https://github.com/xinjia-ctrl/ForgeMind#readme",
  "bugs": {
    "url": "https://github.com/xinjia-ctrl/ForgeMind/issues"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "orchestration",
    "verification",
    "typescript"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.66.0"
  }
}
